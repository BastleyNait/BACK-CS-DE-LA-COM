# ── Variables de entorno del SSP Backend ────────────────────────────────────────
# Copia este archivo a .env para desarrollo local.
# En Vercel, define estas mismas claves en: Project → Settings → Environment Variables.

# Cadena de conexión a PostgreSQL.
# Local:    postgresql://postgres:postgres@localhost:5432/ssp_db
# Supabase: usa el "Connection Pooler" (Transaction, puerto 6543), NO la directa.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ssp_db

# Clave para firmar los JWT. GENERA UNA NUEVA para producción:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS. Acepta lista separada por comas (sin espacios extra).
# En producción incluye el dominio real del frontend en Vercel.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
